{
  "schemaVersion": 1,
  "id": "miehex_revolution",
  "version": "${version}",
  "name": "MieHex:Revolution",
  "description": "MieHex:Revolution addon for Hex Casting,as an addtion for miehex.",
  "authors": [
    "xm1221"
  ],
  "contact": {
    "homepage": "https://xm1221.github.io/MieHex:Revolution",
    "sources": "https://github.com/xm1221/MieHex:Revolution"
  },
  "license": "MIT",
  "icon": "assets/miehex_revolution/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.MieHexRevolution.fabric.FabricMiehex_revolution"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.MieHexRevolution.fabric.FabricMiehex_revolutionClient"
    }],
    "server": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.MieHexRevolution.fabric.FabricMiehex_revolutionServer"
    }],
    "fabric-datagen": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.MieHexRevolution.fabric.datagen.FabricMiehex_revolutionDatagen"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.MieHexRevolution.fabric.FabricMiehex_revolutionModMenu"
    }]
  },
  "mixins": [
    "miehex_revolution-common.mixins.json",
    "miehex_revolution-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "hexcasting": ">=${versions.hexcasting}",
    "cloth-config": ">=${versions.clothConfig}"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}"
  }
}
